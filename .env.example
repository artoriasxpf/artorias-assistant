# openai | deepseek | anthropic
ARTORIAS_MODEL_PROVIDER=deepseek
ARTORIAS_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ARTORIAS_DATA=./data
ARTORIAS_PORT=8765
ARTORIAS_IMAGE=python:3.12-slim

# Existing local directory; all NEW sessions share it when configured.
# Existing sessions retain their persisted binding. Unset: data/workspaces/default
# ARTORIAS_WORKSPACE=/Users/yourname/Projects/my-workspace

# Optional stable identity on FIRST initialization; existing identity is retained.
# ARTORIAS_DEVICE_ID=my-mac

# Standalone search (default). Set the same secret in assistant and search service.
ARTORIAS_SEARCH_MODE=remote
ARTORIAS_SEARCH_URL=http://127.0.0.1:8766
ARTORIAS_SEARCH_TOKEN=replace-with-a-random-service-secret
# Search service only; never point this at app.sqlite.
ARTORIAS_SEARCH_DB=./search-data/search.sqlite
ARTORIAS_SEARCH_COLLECTIONS=tasks
